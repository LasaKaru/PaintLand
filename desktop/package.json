{
  "name": "paintland-desktop",
  "productName": "PaintLand",
  "version": "0.1.0",
  "private": true,
  "description": "PaintLand for Windows: the web game in a locked-down Electron shell.",
  "author": "HelaO2 <support@helao2.com>",
  "homepage": "https://helao2.com",
  "main": "main.cjs",
  "scripts": {
    "copy-web": "node scripts/copy-web.cjs",
    "icon": "node scripts/make-icon.cjs",
    "dist": "npm run copy-web && electron-builder --win --x64 --publish never",
    "dir": "npm run copy-web && electron-builder --dir --publish never",
    "test": "node --test test/security.test.cjs"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lasakaru/paintland.git"
  },
  "license": "UNLICENSED"
}
