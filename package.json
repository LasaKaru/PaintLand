{
  "name": "paintland",
  "private": true,
  "version": "0.1.0",
  "description": "A browser 3D game that looks like a moving watercolour sketchbook. Roads fold into the sky; your path plays the song.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shot": "node tools/screenshot.mjs",
    "server": "npm run build:server && node server/relay.mjs",
    "build:server": "vite build --ssr src/server/verify.ts --outDir dist-server --emptyOutDir",
    "start": "npm run build && npm run build:server && node server/relay.mjs"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/noto-sans-sinhala": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "lil-gui": "^0.21.0",
    "three": "^0.186.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
