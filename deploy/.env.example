# Copy to deploy/.env (never commit the real file).
DOMAIN=play.example.com
EMAIL=you@example.com
# A long passphrase for the admin panel (optional; if empty, the built-in
# login is used — change it in the admin panel's Security tab right away).
ADMIN_PASSWORD=
# Players per room (optional, default from the admin panel).
MAX_ROOM=

# Voice chat relay (optional). Make a secret with:  openssl rand -hex 32
# then start with:  docker compose --profile voice up -d
TURN_SECRET=
TURN_URLS=turn:play.example.com:3478?transport=udp,turn:play.example.com:3478?transport=tcp
